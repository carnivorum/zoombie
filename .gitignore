/kb/# Installed toolchain should live outside the repo (%USERPROFILE%\zoombie-env),
# but ignore it here too in case -Root points inside the workspace.
zoombie-env/

# Generated media / transcript outputs (never commit these).
downloads/
*.wav
*.mp3
*.m4a
*.flac
*.srt

# Retained SOURCE media. The item contract keeps the original video/audio/PDF
# beside summary.md, so a workspace of items otherwise commits hundreds of
# megabytes. Note the transcripts above are already ignored.
*.mp4
*.mkv
*.webm
*.mov
*.avi
*.m4v
*.ogg
*.opus
*.aac
*.pdf

# Item internals: derived material. The visible img/ folder holds only the
# figures a summary actually inlines, so it IS a deliverable and is NOT ignored.
# The legacy .data/ sidecar directory is ignored in case an older checkout still
# carries one.
**/.data/

# Output for sources that are not already part of the workspace. A user's own
# summaries live in their workspace, not in this repo, so ignore the whole tree.
_unsorted/

# Python bytecode from the PDF extractor (scripts/pdf/extract_pdf.py)
__pycache__/
*.py[cod]

# Scratch. .tmp/ is the agent-facing convention every skill states: anything
# temporary an agent writes inside the workspace goes there, so a failed run
# cannot pollute the tree. work/ is the toolchain's own scratch, ignored in case
# -WorkRoot points inside the repo.
.tmp/
work/

# Live test. The INSTRUCTIONS and the RUNNER are TRACKED -- they are the durable
# part, and a fresh clone must be able to read them -- so the whole folder is NOT
# ignored. Only the harness it builds and the user's own sample media are.
#
# The media lines are redundant against the global *.pdf/*.mp4 rules above, and
# are kept deliberately: they make "these samples stay on this machine" a LOCAL
# guarantee that survives a later narrowing of the global patterns.
tests/livetest/ws/
tests/livetest/out/
tests/livetest/*.pdf
tests/livetest/*.mp4